---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Abdelrhamane Berdjeghloul
	<div class="social-links">
		<a href="https://github.com/aberdjeghloul" target="_blank">GitHub</a>
		<a href="https://gitlab.com/abdelrhamane-devops" target="_blank">GitLab</a>
		<a href="https://linkedin.com/in/abdelrhamane-berdjeghloul-66a84a53" target="_blank">LinkedIn</a>
		<a href="mailto:aberdjeghloul@gmail.com">Contact</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
