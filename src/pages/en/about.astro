---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { t } from '../../i18n/translations';

const lang = 'en';
const tr = t(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={`${tr.about.title} — Abdelrhamane Berdjeghloul`} description="DevOps & Cloud Engineer" />
    <style>
      .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem; }
      h1 { margin-bottom: 0.25rem; }
      .subtitle { color: rgb(var(--gray)); margin: 0 0 2rem; font-size: 1.1rem; }
      h2 { border-bottom: 2px solid rgb(var(--accent)); padding-bottom: 0.5rem; margin-bottom: 1rem; }
      .skill-group { margin-bottom: 1.5rem; }
      .skill-group h3 { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; color: rgb(var(--gray)); margin: 0 0 0.5rem; }
      .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .tag { background: rgb(var(--gray-light)); color: rgb(var(--gray-dark)); padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.85rem; }
      .contact-links { display: flex; flex-direction: column; gap: 0.75rem; }
      .contact-links a { color: rgb(var(--accent)); text-decoration: none; font-weight: 600; }
      .contact-links a:hover { text-decoration: underline; }
      .contact-links a.cv-btn { display: inline-block; align-self: flex-start; margin-top: 0.5rem; background: rgb(var(--accent)); color: white; padding: 0.5rem 1.25rem; border-radius: 8px; font-weight: 700; transition: opacity 0.2s; }
      .contact-links a.cv-btn:hover { opacity: 0.85; text-decoration: none; }
      .parcours { margin-bottom: 2rem; }
      .timeline { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
      .timeline li { display: flex; gap: 1.25rem; align-items: baseline; }
      .timeline .year { font-weight: 700; color: rgb(var(--accent)); min-width: 4.5rem; font-size: 0.9rem; }
      .timeline .desc { color: rgb(var(--gray-dark)); font-size: 0.95rem; line-height: 1.4; }
      .diploma { display: inline-block; margin-top: 0.25rem; background: rgb(var(--accent)); color: white; padding: 0.15rem 0.6rem; border-radius: 20px; font-size: 0.78rem; font-weight: 600; }
      @media (max-width: 720px) { .about-grid { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <h1>Abdelrhamane Berdjeghloul</h1>
      <p class="subtitle">{tr.about.subtitle}</p>
      <p>{tr.about.bio1}</p>
      <p>{tr.about.bio2}</p>
      <div class="parcours">
        <h2>Background</h2>
        <ul class="timeline">
          <li>
            <span class="year">2003 – 2010</span>
            <span class="desc">.NET Consultant — LOGICA/CGI · Enterprise clients: Canal+, L'Oréal, Monoprix, Johnson &amp; Johnson, Syngenta (ASP.NET, C#, SharePoint)</span>
          </li>
          <li>
            <span class="year">2010 – 2016</span>
            <span class="desc">IT Project Manager — vente-privee.com · Transport IS: 13 warehouses, 18 carriers, 50,000 parcels/day</span>
          </li>
          <li>
            <span class="year">2016 – 2020</span>
            <span class="desc">Software Engineer — ALTIMATE · Projects: BPCE (market data warehouse), KANTAR WORLDPANEL, HOMEBOX</span>
          </li>
          <li>
            <span class="year">2020 – 2022</span>
            <span class="desc">Backend Developer — QOBUZ · Financial reporting automation (.NET C#, REST API)</span>
          </li>
          <li>
            <span class="year">2022 – 2025</span>
            <span class="desc">Senior .NET Consultant — INGENIANCE · Client: BNP Personal Finance · Fraud detection (.NET 8.0, Jenkins, Splunk, Dynatrace)</span>
          </li>
          <li>
            <span class="year">Jan – Mar 2026</span>
            <span class="desc">
              Intensive DevOps training — La Capsule, Paris (400h)<br />
              <span class="diploma">Titre Pro Administrateur Système DevOps · RNCP Level 6</span>
            </span>
          </li>
          <li>
            <span class="year">2026</span>
            <span class="desc">Taiga production deployment on AWS — Docker Swarm Multi-AZ, Terraform, Ansible, GitLab CI/CD, Prometheus/Grafana</span>
          </li>
        </ul>
      </div>
      <div class="about-grid">
        <section>
          <h2>{tr.about.skills}</h2>
          <div class="skill-group">
            <h3>{tr.about.groups.cloud}</h3>
            <div class="tags"><span class="tag">AWS</span><span class="tag">Terraform</span><span class="tag">Ansible</span></div>
          </div>
          <div class="skill-group">
            <h3>{tr.about.groups.containers}</h3>
            <div class="tags"><span class="tag">Docker</span><span class="tag">Docker Swarm</span><span class="tag">Kubernetes</span><span class="tag">Helm</span></div>
          </div>
          <div class="skill-group">
            <h3>{tr.about.groups.cicd}</h3>
            <div class="tags"><span class="tag">GitLab CI/CD</span><span class="tag">GitHub Actions</span><span class="tag">SonarCloud</span><span class="tag">Trivy</span><span class="tag">Hadolint</span></div>
          </div>
          <div class="skill-group">
            <h3>{tr.about.groups.monitoring}</h3>
            <div class="tags"><span class="tag">Prometheus</span><span class="tag">Grafana</span><span class="tag">Node Exporter</span><span class="tag">cAdvisor</span></div>
          </div>
          <div class="skill-group">
            <h3>{tr.about.groups.dev}</h3>
            <div class="tags"><span class="tag">C#</span><span class="tag">.NET</span><span class="tag">Python</span><span class="tag">Bash</span><span class="tag">SQL</span></div>
          </div>
        </section>
        <section>
          <h2>Certifications</h2>
          <div class="skill-group">
            <div class="tags">
              <span class="tag">Titre Pro DevOps RNCP 6 — La Capsule (2026)</span>
              <span class="tag">PSM I — Professional Scrum Master (2015)</span>
              <span class="tag">PRINCE2 Foundation &amp; Practitioner (2015)</span>
            </div>
          </div>
          <h2>{tr.about.contact}</h2>
          <div class="contact-links">
            <a href="mailto:aberdjeghloul@gmail.com">aberdjeghloul@gmail.com</a>
            <a href="https://github.com/aberdjeghloul" target="_blank">github.com/aberdjeghloul</a>
            <a href="https://gitlab.com/abdelrhamane-devops" target="_blank">gitlab.com/abdelrhamane-devops</a>
            <a href="https://linkedin.com/in/abdelrhamane-berdjeghloul-66a84a53" target="_blank">LinkedIn</a>
            <a href="https://aberdjeghloul.github.io/cv" target="_blank" style="display:inline-block;margin-top:0.5rem;background:#4f46e5;color:white;padding:0.5rem 1.25rem;border-radius:8px;font-weight:700;text-decoration:none;">CV online</a>
            <a href="https://drive.google.com/uc?export=download&id=1TsO9GsLPVBtNWFe213P8K89l3kBbW4H9" target="_blank" style="display:inline-block;margin-top:0.5rem;background:#374151;color:white;padding:0.5rem 1.25rem;border-radius:8px;font-weight:700;text-decoration:none;">Download CV (PDF)</a>
          </div>
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>
