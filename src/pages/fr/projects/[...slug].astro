---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { t } from '../../../i18n/translations';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

type Props = CollectionEntry<'projects'>;
const lang = 'fr';
const tr = t(lang);
const project = Astro.props;
const { Content } = await render(project);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={`${project.data.title} — Abdelrhamane Berdjeghloul`} description={project.data.description} />
    <style>
      .project-header { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgb(var(--gray-light)); }
      h1 { margin-bottom: 0.5rem; }
      .description { color: rgb(var(--gray)); font-size: 1.1rem; margin: 0 0 1rem; }
      .stack { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
      .tag { background: rgb(var(--gray-light)); color: rgb(var(--gray-dark)); padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.85rem; }
      .project-links { display: flex; gap: 1rem; }
      .project-links a { color: rgb(var(--accent)); text-decoration: none; font-weight: 600; }
      .project-links a:hover { text-decoration: underline; }
      .back { margin-bottom: 1.5rem; }
      .back a { color: rgb(var(--gray)); text-decoration: none; font-size: 0.9rem; }
      .back a:hover { color: rgb(var(--accent)); }
    </style>
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <div class="back"><a href={`/${lang}/projects/`}>{tr.projects.back}</a></div>
      <div class="project-header">
        <h1>{project.data.title}</h1>
        <p class="description">{project.data.description}</p>
        <div class="stack">
          {project.data.stack.map((tech) => <span class="tag">{tech}</span>)}
        </div>
        <div class="project-links">
          {project.data.live && <a href={project.data.live} target="_blank">{tr.projects.live} ↗</a>}
          {project.data.github && <a href={project.data.github} target="_blank">GitHub ↗</a>}
          {project.data.gitlab && <a href={project.data.gitlab} target="_blank">GitLab ↗</a>}
        </div>
      </div>
      <Content />
    </main>
    <Footer />
  </body>
</html>
