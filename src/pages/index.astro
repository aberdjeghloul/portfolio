---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 3rem 0 2rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				margin-bottom: 2rem;
			}
			.hero h1 {
				margin: 0 0 0.5rem;
				font-size: 2.5rem;
			}
			.hero .subtitle {
				font-size: 1.2rem;
				color: rgb(var(--gray));
				margin: 0 0 1.5rem;
			}
			.stack-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1.5rem;
			}
			.tag {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				padding: 0.25rem 0.75rem;
				border-radius: 20px;
				font-size: 0.85rem;
			}
			.links {
				display: flex;
				gap: 1rem;
			}
			.links a {
				color: rgb(var(--accent));
				text-decoration: none;
				font-weight: 600;
			}
			.links a:hover {
				text-decoration: underline;
			}
			h2 {
				margin: 0 0 1.5rem;
			}
			.projects-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 1.5rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.project-card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5rem;
				transition: box-shadow 0.2s ease, border-color 0.2s ease;
			}
			.project-card:hover {
				box-shadow: var(--box-shadow);
				border-color: rgb(var(--accent));
			}
			.project-card h3 {
				margin: 0 0 0.5rem;
				font-size: 1.1rem;
			}
			.project-card p {
				color: rgb(var(--gray));
				font-size: 0.9rem;
				margin: 0 0 1rem;
				line-height: 1.5;
			}
			.project-stack {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin-bottom: 1rem;
			}
			.project-stack .tag {
				font-size: 0.75rem;
			}
			.project-links {
				display: flex;
				gap: 0.75rem;
			}
			.project-links a {
				font-size: 0.85rem;
				color: rgb(var(--accent));
				text-decoration: none;
				font-weight: 600;
			}
			.project-links a:hover {
				text-decoration: underline;
			}
			@media (max-width: 720px) {
				.hero h1 { font-size: 1.8rem; }
				.projects-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Abdelrhamane Berdjeghloul</h1>
				<p class="subtitle">DevOps & Cloud Engineer · Senior .NET Developer · 20+ years experience</p>
				<div class="stack-tags">
					<span class="tag">AWS</span>
					<span class="tag">Terraform</span>
					<span class="tag">Ansible</span>
					<span class="tag">Docker Swarm</span>
					<span class="tag">Kubernetes</span>
					<span class="tag">GitLab CI/CD</span>
					<span class="tag">Prometheus</span>
					<span class="tag">Grafana</span>
					<span class="tag">C# / .NET</span>
					<span class="tag">Python</span>
				</div>
				<div class="links">
					<a href="https://github.com/aberdjeghloul" target="_blank">GitHub</a>
					<a href="https://gitlab.com/abdelrhamane-devops" target="_blank">GitLab</a>
					<a href="https://linkedin.com/in/abdelrhamane-berdjeghloul-66a84a53" target="_blank">LinkedIn</a>
					<a href="/about">About me</a>
				</div>
			</section>

			<section>
				<h2>Projects</h2>
				<ul class="projects-grid">
					{projects.map((project) => (
						<li class="project-card">
							<h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
							<p>{project.data.description}</p>
							<div class="project-stack">
								{project.data.stack.map((tech) => (
									<span class="tag">{tech}</span>
								))}
							</div>
							<div class="project-links">
								{project.data.live && <a href={project.data.live} target="_blank">Live ↗</a>}
								{project.data.github && <a href={project.data.github} target="_blank">GitHub ↗</a>}
								{project.data.gitlab && <a href={project.data.gitlab} target="_blank">GitLab ↗</a>}
								<a href={`/projects/${project.id}/`}>Details →</a>
							</div>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
